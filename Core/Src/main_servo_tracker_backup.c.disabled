#define SERVO_FORWARD_US 1500U /* Adjust after mechanically aligning the sensor. */
#define SERVO_US_PER_DEG 10U    /* Approximate SG90 scale; displayed angle is relative. */
#define SCAN_HALF_US 600
#define SCAN_STEP_US 75
#define SCAN_COUNT (2U * SCAN_HALF_US / SCAN_STEP_US + 1U)
#define TARGET_MIN_MM 100U
#define TARGET_MAX_MM 300U
#define PING_GAP_MS 60U
#define SERVO_SETTLE_MS 100U

