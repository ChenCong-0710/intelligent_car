static TrackerState tracker_state;
static int16_t scan_offset_us;
static int8_t scan_direction;
static uint8_t lock_misses;
static bool sweep_completed;
static uint16_t first_mm, best_servo_us, tracked_mm;
static uint16_t scan_ranges[SCAN_COUNT];
static uint8_t scan_samples;
static uint32_t servo_changed_ms, last_ping_ms, state_changed_ms, last_screen_ms;
