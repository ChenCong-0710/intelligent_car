set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(ARM_GCC_BIN "$ENV{ARM_GCC_BIN}" CACHE PATH "Directory containing Arm GNU executables")
if(NOT ARM_GCC_BIN AND WIN32)
  file(GLOB _bundles "$ENV{LOCALAPPDATA}/stm32cube/bundles/gnu-tools-for-stm32/*/bin")
  list(SORT _bundles COMPARE NATURAL ORDER DESCENDING)
  foreach(_dir IN LISTS _bundles)
    if(EXISTS "${_dir}/arm-none-eabi-gcc.exe")
      set(ARM_GCC_BIN "${_dir}" CACHE PATH "Arm GNU bin" FORCE)
      break()
    endif()
  endforeach()
endif()
find_program(CMAKE_C_COMPILER NAMES arm-none-eabi-gcc HINTS "${ARM_GCC_BIN}" REQUIRED)
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
find_program(CMAKE_OBJCOPY NAMES arm-none-eabi-objcopy HINTS "${ARM_GCC_BIN}" REQUIRED)
find_program(CMAKE_SIZE NAMES arm-none-eabi-size HINTS "${ARM_GCC_BIN}" REQUIRED)
